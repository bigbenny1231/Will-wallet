## create vault (interval 120 s while we set it up, grace 1, 5 NEAR + 0.1 storage)
## (testnet txs take ~5-10 s each, so the alive phase runs at 120 s and set_timing drops it to 20 s before the owner goes silent)
$ node contracts/tools/tx.mjs call dmw-smoke-owner-fb1b.testnet dmw-979268.testnet create_vault {...} 100 5.1
tx https://testnet.nearblocks.io/txns/6jYq4r5cSDRRkM4NHSrtQcTNe4wABVCu5URAE6m5hAji
  log: EVENT_JSON:{"standard":"dmw","version":"1.0.0","event":"vault_created","data":{"token_id":"2","owner_id":"dmw-smoke-owner-fb1b.testnet","balance":"5000000000000000000000000","heartbeat_interval_s":120,"grace_missed":1}}
  log: EVENT_JSON:{"standard":"nep171","version":"1.0.0","event":"nft_mint","data":[{"owner_id":"dmw-smoke-owner-fb1b.testnet","token_ids":["2"]}]}
  result: "2"
