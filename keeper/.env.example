# Dead Man's Wallet keeper. Copy to keeper/.env (or the repo-root .env) and fill in. Never commit the real file.

# NEAR network; only testnet is wired for the hackathon.
NEAR_NETWORK=testnet
# Optional RPC override (default https://rpc.testnet.fastnear.com)
# NEAR_RPC=https://rpc.testnet.fastnear.com

# The deployed dmw contract account. `make deploy` writes this into the repo-root .env.
DMW_CONTRACT=dmw-1.testnet

# Account that signs poke / execute_step / mark_broadcast (any funded testnet account works; anyone may call them).
KEEPER_ACCOUNT_ID=dmw-keeper-abc123.testnet
KEEPER_PRIVATE_KEY=ed25519:REPLACE_ME

# Foreign chains (SPEC section 1)
BASE_RPC=https://sepolia.base.org
# MONAD_RPC=https://testnet-rpc.monad.xyz
SOLANA_RPC=https://api.devnet.solana.com

# Function-call keys that live on the CONTRACT account; can also be passed with --key.
# DMW_PULSE_KEY=ed25519:...
# DMW_AGENT_KEY=ed25519:...

# Offline demo: 1 = simulate a vault locally, no NEAR/Base/Solana calls.
DMW_MOCK=0
# DMW_MOCK_INTERVAL=20        # heartbeat interval of the seeded mock vault (s)
# DMW_MOCK_GRACE=1            # grace_missed of the seeded mock vault
# DMW_MOCK_FILE=keeper/.mock-state.json
