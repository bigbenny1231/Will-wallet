# Lastword keeper. Copy to keeper/.env (or the repo-root .env) and fill in. Never commit the real file.

# NEAR network; only testnet is wired for the hackathon.
NEAR_NETWORK=testnet
# Optional RPC override (default https://rpc.testnet.fastnear.com)
# NEAR_RPC=https://rpc.testnet.fastnear.com

# The deployed dmw contract account. `make deploy` writes this into the repo-root .env.
DMW_CONTRACT=dmw-1.testnet

# Account that signs poke / execute_step / mark_broadcast (any funded testnet account works; anyone may call them).
KEEPER_ACCOUNT_ID=dmw-keeper-abc123.testnet
KEEPER_PRIVATE_KEY=ed25519:REPLACE_ME

# Foreign chains (SPEC section 1)
BASE_RPC=https://sepolia.base.org
# MONAD_RPC=https://testnet-rpc.monad.xyz
SOLANA_RPC=https://api.devnet.solana.com

# Function-call keys that live on the CONTRACT account; can also be passed with --key.
# DMW_PULSE_KEY=ed25519:...
# DMW_AGENT_KEY=ed25519:...

# Owner notifications (optional). The keeper POSTs one JSON message when a vault enters Warning or Triggered.
# Works as-is with Slack and Discord incoming webhooks. The URL is a secret; the keeper never prints it.
# DMW_NOTIFY_WEBHOOK=https://example.com/your/webhook/path
# Phone push through ntfy (optional, free, no account): install the ntfy app, subscribe to a hard-to-guess topic, set it here.
# Anyone who knows the topic can read the pushes; the keeper never prints it.
# DMW_NOTIFY_NTFY_TOPIC=dmw-pick-a-long-random-topic
# DMW_NOTIFY_NTFY_SERVER=https://ntfy.sh
# Base URL for the vault link in those messages (default https://will-wallet.vercel.app).
# DMW_DASHBOARD_URL=https://will-wallet.vercel.app

# Funding foreign payout sources (optional). The funder wallet is derived from KEEPER_SEED (at least 32 characters);
# `dmw funder` prints its addresses. `dmw fund-sources --token <id>` or `dmw keeper --fund-sources` (or
# DMW_FUND_SOURCES=1) tops sources up. Caps, in ETH / MON / SOL (defaults shown):
# KEEPER_SEED=
# DMW_FUND_SOURCES=1
# FUND_CAP_ETH=0.002
# FUND_CAP_MON=0.05
# FUND_CAP_SOL=0.02
# FUND_RUN_CAP_ETH=0.01
# FUND_RUN_CAP_MON=0.25
# FUND_RUN_CAP_SOL=0.1

# Offline demo: 1 = simulate a vault locally, no NEAR/Base/Solana calls.
DMW_MOCK=0
# DMW_MOCK_INTERVAL=20        # heartbeat interval of the seeded mock vault (s)
# DMW_MOCK_GRACE=1            # grace_missed of the seeded mock vault
# DMW_MOCK_FILE=keeper/.mock-state.json
