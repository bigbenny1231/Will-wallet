# Contract account that hosts the vaults (see /.env DMW_CONTRACT at the repo root)
VITE_DMW_CONTRACT=dmw-979268.testnet
# testnet | mainnet (default testnet)
VITE_NEAR_NETWORK=testnet
# Optional RPC override
# VITE_NEAR_RPC=https://rpc.testnet.fastnear.com
# Set to 1 to run against a fake vault that cycles Alive -> Warning -> Triggered -> Settled every 20 s
VITE_DMW_MOCK=0
# Optional Sputnik UI base (e.g. https://testnet.app.astrodao.com). Empty = link the DAO account on nearblocks.
# VITE_SPUTNIK_UI=
# Optional foreign-chain RPCs used by "Execute next step" (step 3 args) and "Broadcast"
# VITE_BASE_RPC=https://sepolia.base.org
# VITE_MONAD_RPC=https://testnet-rpc.monad.xyz
# VITE_SOLANA_RPC=https://api.devnet.solana.com
# Origin a phone can reach, used in the pairing QR code (default: this page's origin)
# VITE_PUBLIC_ORIGIN=https://deadmans-wallet.vercel.app
# NEAR Auth (heir sign-in with Google). Defaults are the shared testnet client, which only accepts http://localhost:3000
# VITE_NEAR_AUTH_CLIENT_ID=
# VITE_NEAR_AUTH_DOMAIN=login.testnet.fast-auth.com
# VITE_NEAR_AUTH_ORIGINS=http://localhost:3000
