# Contract account that hosts the vaults (see /.env DMW_CONTRACT at the repo root)
VITE_DMW_CONTRACT=dmw-1.testnet
# testnet | mainnet (default testnet)
VITE_NEAR_NETWORK=testnet
# Optional RPC override
# VITE_NEAR_RPC=https://rpc.testnet.near.org
# Set to 1 to run against a fake vault that cycles Alive -> Warning -> Triggered -> Settled every 20 s
VITE_DMW_MOCK=0
# Optional Sputnik UI base (e.g. https://testnet.app.astrodao.com). Empty = link the DAO account on nearblocks.
# VITE_SPUTNIK_UI=
