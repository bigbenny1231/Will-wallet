# Repo-root .env for Dead Man's Wallet. `make deploy` writes all of this for you; copy by hand only if you
# want to reuse accounts you already have. Never commit the real file (it is gitignored).

NEAR_NETWORK=testnet
# Optional RPC override (default https://rpc.testnet.fastnear.com)
# NEAR_RPC=https://rpc.testnet.fastnear.com

# The deployed dmw contract account. Its full-access key stays in keys/<acct>.json (created by the faucet step,
# mode 0600); it is not copied into this file.
DMW_CONTRACT=dmw-abc123.testnet
DMW_CONTRACT_KEYFILE=keys/dmw-abc123.testnet.json

# Account that signs poke / execute_step / mark_broadcast (anyone may call them; this one is also
# registered with set_keeper so it may re-sign stale Solana payouts)
KEEPER_ACCOUNT_ID=dmw-keeper-abc123.testnet
KEEPER_PRIVATE_KEY=ed25519:REPLACE_ME

# Foreign chains
BASE_RPC=https://sepolia.base.org
SOLANA_RPC=https://api.devnet.solana.com
